+// 23603 - Nefarian Class Call Mage - Polymorph: the client data hits every ally of the mage within 100 yards; only the
+// player the mage casts at is polymorphed (VMaNGOS and CMaNGOS limit the spell to one target)
+class classic_spell_nefarian_polymorph_target : public SpellScript
+{
+    void FilterTargets(std::list<WorldObject*>& targets)
+    {
+        if (_chosen.IsEmpty())
+        {
+            Unit* wanted = GetExplTargetUnit();
+            auto it = std::find_if(targets.begin(), targets.end(), [wanted](WorldObject const* target) { return target == wanted; });
+            if (it != targets.end())
+                _chosen = (*it)->GetGUID();
+            else if (!targets.empty())
+                _chosen = Trinity::Containers::SelectRandomContainerElement(targets)->GetGUID();
+        }
+        targets.remove_if([this](WorldObject const* target) { return target->GetGUID() != _chosen; });
+    }
+
+    void Register() override
+    {
+        OnObjectAreaTargetSelect += SpellObjectAreaTargetSelectFn(classic_spell_nefarian_polymorph_target::FilterTargets, EFFECT_ALL, TARGET_UNIT_SRC_AREA_ALLY);
+    }
+
+    ObjectGuid _chosen;
+};
+
