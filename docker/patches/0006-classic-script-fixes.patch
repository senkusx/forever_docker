+        // the wave of each of Rajaxx's creatures that is still alive, by its formation's officer
+        void GatherRajaxxWaves()
+        {
+            for (GuidVector& members : m_rajaxxWaveMembers)
+                members.clear();
+            for (auto const& [guid, watch] : m_combatWatch)
+            {
+                Creature* creature = instance->GetCreature(guid);
+                if (!creature || !creature->IsAlive() || !ClassicAQ20IsRajaxxWaveEntry(creature->GetEntry()))
+                    continue;
+                uint32 const leader = ClassicAQ20GetFormationLeaderEntry(creature);
+                for (uint32 i = 0; i < ClassicAQ20RajaxxWaves.size(); ++i)
+                    if (ClassicAQ20RajaxxWaves[i].Leader == leader || ClassicAQ20RajaxxWaves[i].Leader == creature->GetEntry())
+                    {
+                        m_rajaxxWaveMembers[i].push_back(guid);
+                        break;
+                    }
+            }
+        }
+
+        bool RajaxxWaveAlive(uint32 wave) const
+        {
+            for (ObjectGuid const& guid : m_rajaxxWaveMembers[wave])
+                if (Creature* creature = instance->GetCreature(guid))
+                    if (creature->IsAlive())
+                        return true;
+            return false;
+        }
+
+        // a pack of the army engaged, pulled or sent: the army moves, and that wave counts as sent
+        void RajaxxWaveEngaged(Creature* creature)
+        {
+            if (GetBossState(CLASSIC_AQ20_TYPE_RAJAXX) == DONE)
+                return;
+            if (!m_rajaxxArmyMoving)
+            {
+                GatherRajaxxWaves();
+                m_rajaxxArmyMoving = true;
+                m_rajaxxWaveTimer = CLASSIC_AQ20_RAJAXX_NEXT_WAVE_ANYWAY;
+            }
+            for (uint32 i = 0; i < m_rajaxxWaveMembers.size(); ++i)
+                if (std::find(m_rajaxxWaveMembers[i].begin(), m_rajaxxWaveMembers[i].end(), creature->GetGUID()) != m_rajaxxWaveMembers[i].end())
+                    m_rajaxxWavesSent |= 1 << i;
+        }
+
+        void SendRajaxxWave(uint32 wave)
+        {
+            m_rajaxxWavesSent |= 1 << wave;
+            Creature* rajaxx = instance->GetCreature(m_uiRajaxxGUID);
+            if (rajaxx && rajaxx->IsAlive() && ClassicAQ20RajaxxWaves[wave].Yell)
+                ClassicScriptText(ClassicAQ20RajaxxWaves[wave].Yell, rajaxx);
+            for (ObjectGuid const& guid : m_rajaxxWaveMembers[wave])
+                if (Creature* creature = instance->GetCreature(guid))
+                    if (creature->IsAlive() && !creature->IsEngaged() && creature->IsAIEnabled())
+                        creature->AI()->DoZoneInCombat();
+        }
+
+        // the next wave in Rajaxx's order that is still alive; with none left and the last ones down, Rajaxx himself
+        void SendNextRajaxxWave(bool sentDown)
+        {
+            GatherRajaxxWaves();    // packs of grids loaded since the army moved
+            m_rajaxxClearedTimer = 0;
+            m_rajaxxWaveTimer = CLASSIC_AQ20_RAJAXX_NEXT_WAVE_ANYWAY;
+            for (uint32 i = 0; i < ClassicAQ20RajaxxWaves.size(); ++i)
+                if (!(m_rajaxxWavesSent & (1 << i)) && RajaxxWaveAlive(i))
+                {
+                    SendRajaxxWave(i);
+                    return;
+                }
+            if (!sentDown)
+                return;
+            m_rajaxxHimself = true;
+            if (Creature* rajaxx = instance->GetCreature(m_uiRajaxxGUID))
+                if (rajaxx->IsAlive() && rajaxx->IsAIEnabled())
+                {
+                    ClassicScriptText(CLASSIC_AQ20_SAY_RAJAXX_ATTACK, rajaxx);
+                    SetRajaxxWaiting(rajaxx, false);
+                    if (!rajaxx->IsEngaged())
+                        rajaxx->AI()->DoZoneInCombat();
+                }
+        }
+
+        // while his army fights, Rajaxx stands passive and cannot be killed (his SmartAI on spawn: react passive,
+        // invincible at 1 health); he fights once it is beaten
+        void SetRajaxxWaiting(Creature* rajaxx, bool waiting)
+        {
+            rajaxx->SetReactState(waiting ? REACT_PASSIVE : REACT_AGGRESSIVE);
+            if (SmartAI* smart = dynamic_cast<SmartAI*>(rajaxx->AI()))
+                smart->SetInvincibilityHpLevel(waiting ? 1 : 0);
+        }
+
+        void UpdateRajaxxWaves(uint32 diff)
+        {
+            if (m_rajaxxHimself || GetBossState(CLASSIC_AQ20_TYPE_RAJAXX) == DONE)
+                return;
+            if (!m_rajaxxArmyMoving)
+            {
+                // Rajaxx himself pulled: what is left of his army comes first, then he does
+                Creature* rajaxx = instance->GetCreature(m_uiRajaxxGUID);
+                if (!rajaxx || !rajaxx->IsAlive() || !rajaxx->IsEngaged())
+                    return;
+                GatherRajaxxWaves();
+                m_rajaxxArmyMoving = true;
+                m_rajaxxWaveTimer = CLASSIC_AQ20_RAJAXX_NEXT_WAVE_ANYWAY;
+            }
+            bool fighting = false;
+            for (uint32 i = 0; i < ClassicAQ20RajaxxWaves.size() && !fighting; ++i)
+                fighting = (m_rajaxxWavesSent & (1 << i)) && RajaxxWaveAlive(i);
+            if (!fighting)
+            {
+                if (!m_rajaxxClearedTimer)
+                    m_rajaxxClearedTimer = CLASSIC_AQ20_RAJAXX_NEXT_WAVE_CLEARED;
+                else if (m_rajaxxClearedTimer <= diff)
+                {
+                    SendNextRajaxxWave(true);
+                    return;
+                }
+                else
+                    m_rajaxxClearedTimer -= diff;
+            }
+            if (m_rajaxxWaveTimer <= diff)
+                SendNextRajaxxWave(!fighting);
+            else
+                m_rajaxxWaveTimer -= diff;
+        }
+
+        // a wipe: the packs still alive wait in their place again, the ones cut down stay down, and Rajaxx behind them
+        void ResetRajaxxWaves()
+        {
+            if (m_rajaxxHimself)
+                if (Creature* rajaxx = instance->GetCreature(m_uiRajaxxGUID))
+                    if (rajaxx->IsAlive())
+                        SetRajaxxWaiting(rajaxx, true);
+            m_rajaxxArmyMoving = false;
+            m_rajaxxWavesSent = 0;
+            m_rajaxxHimself = false;
+            m_rajaxxClearedTimer = 0;
+            m_rajaxxWaveTimer = 0;
         }
 
